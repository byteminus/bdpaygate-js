  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint --strict && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:package"
