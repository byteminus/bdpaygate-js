{
  "name": "bdpaygate",
  "version": "0.1.0",
  "description": "Bangladeshi payment gateways for Node.js, Bun, Deno and the edge: bKash, Nagad, SSLCommerz, Upay, ShurjoPay, aamarPay, PortPos, PayStation, UddoktaPay, Moneybag, EPS and DGePay behind one typed API, with verified callbacks, refunds and adapters for Express, Next.js, NestJS, Fastify, Hono, Koa, Nuxt, SvelteKit, React Router, Astro and AdonisJS.",
  "keywords": [
    "bkash",
    "nagad",
    "sslcommerz",
    "upay",
    "shurjopay",
    "aamarpay",
    "portpos",
    "paystation",
    "uddoktapay",
    "moneybag",
    "eps",
    "dgepay",
    "rocket",
    "payment-gateway",
    "bangladesh",
    "bdt",
    "mobile-banking",
    "express",
    "nextjs",
    "nestjs",
    "fastify",
    "hono",
    "typescript"
  ],
  "homepage": "https://bdpaygate.github.io/node/",
  "bugs": "https://github.com/byteminus/bdpaygate-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byteminus/bdpaygate-js.git"
  },
  "license": "MIT",
  "author": "ByteMinus",
  "type": "module",
  "sideEffects": false,
